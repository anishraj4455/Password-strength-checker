if __name__ == '__main__':
    n = int(input().strip())
    
    # If n is odd
    if n % 2 != 0:
        print("Weird")
    # If n is even
    else:
        if 2 <= n <= 5:
            print("Not Weird")
        else 6 <= n <= 20:
            print("Weird")
        else:  # n > 20
            print("Not Weird")
